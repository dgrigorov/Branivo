# Exact versions only — prevents silent upgrades to compromised patch releases.
# Supply chain attacks (e.g. axios 1.8.2, event-stream) often land in patch/minor
# bumps that semver ranges like ^ or ~ silently accept.
# With save-exact=true, `npm install <pkg>` records "1.2.3" not "^1.2.3".
save-exact=true
