# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=branivo
DATABASE_PASS=branivo
DATABASE_NAME=branivo_dev
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# App
NODE_ENV=development
PORT=3000
API_VERSION=v1

# AWS
AWS_REGION=eu-central-1
AWS_S3_BUCKET=branivo-documents-dev
AWS_CLOUDFRONT_DOMAIN=d1234example.cloudfront.net

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PCT=0.05

# Onboarding
ONBOARDING_JWT_SECRET=change-me-onboarding-secret
FRONTEND_URL=https://onboarding.branivo.bg

# Email (SMTP — Mailhog in dev: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Branivo <noreply@branivo.com>"

# Speedy (Bulgarian courier)
SPEEDY_API_URL=https://api.speedy.bg
SPEEDY_USERNAME=your-speedy-username
SPEEDY_PASSWORD=your-speedy-password

# Econt (Bulgarian courier)
ECONT_API_URL=https://ee.econt.com
ECONT_USERNAME=your-econt-username
ECONT_PASSWORD=your-econt-password

# Guarantee Fund (Гаранционен фонд) API
# NOTE: Официалният URL на ГФ се предоставя при договор с Гаранционен фонд (www.guaranteefund.bg).
# Ако не е конфигуриран, адаптерът връща mock clean result (manual_fallback) — без блокиране.
GF_API_BASE_URL=
GF_API_KEY=

# VAPID — Web Push Notifications (PWA)
# Генерирай с: cd branivo-api && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:admin@branivo.io
